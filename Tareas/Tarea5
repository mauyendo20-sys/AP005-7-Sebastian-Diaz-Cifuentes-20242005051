#Importamos la libreria "Time" para despues pausar el codigo y permitir leer la consola 
import time
#Son los datos de entrada, de los cuales la debe red aprender algo
inputs = [1, 2, 3, 4]
#Son los resultados esperados, que es el doble de los datos de entrada(El objetivo de la computadora es hallar ese 2)
targets = [2, 4, 6, 8]
#Valor a leatorio que llamamos peso,multiplicador que usara la computadora para adivinar, inicia en 0.1 (1*0.1) el entrenamiento interara que se vuelva un 2
w = 0.1
#Es la taza de aprendizaje, tamaño de los pasos, si es muy grande puede pasarse si es muy pequeño tardara muchos intetnos 
learning_rate = 0.1
#Representa una neurona,crea una funcion (def), toma un valor de entrada "i"y lo multiplica por eso peso, para luego devolverlo.
def predict(i):
  return w*i

#Train the network
#El bucle for se repita 30 veces, usamsos " _ " como una variable,ya que no interesa el numero del ciclo y solo queremos que se repita 30 veces.
for _ in range(30):
#Toma los imputs, los pasa por la funcion pred y guarda las adivinanzas resultantes 
  pred = [predict(i) for i in inputs]
#"zip(pred, targets)" empareja las dos listas, junta la primera prediccion con el 1er target luego le resta a t(target), p(predict)
#Ejemplo si el target es 2 y predijimos 0.1 el error es 1.9, asi hasta crear la lista de errores de los 4 numeros
  errors = [t - p for p, t in zip(pred, targets)]
#Esta linea es la encargada de ver que tan equivocada esta, haciendo un promedio de los errores.
  cost = sum(errors)/len(targets)
#Imprimimos los valores objetivos (f sirve para insertar variables)
  print(f"Targets: ", targets)
#Imprimimos la prediccion 
  print(f"Predictions: ", pred)
#Imprimimos el error
  print(f"Errors: ", errors)
#Mostramos el peso actual, especificamos que por lo menos 10 decimales y el costo con 6 decimales 
  print(f"Weight: {w: .10f}, Cost: {cost:.6f}")
#Tomamos el peso actual y le sumamos el ajuste, que el ajuste es el costo y la taza de aprendizaje 
  w += learning_rate*cost
#Espacio en blanco
  print ()
#Imprimimos Nueva epoca
  print ("Nueva epoca") 
#Espacio en blanco
  print ()
#Imprimimos Nuevos pesos
  print ("Nuevos pesos")
#Imprimimos el peso (que va variando)
  print (w)
#Espacio en blanco
  print ()
#Congela la ejecucion por 1 seg
  time.sleep(1)

#Test the network:
#Ya despues de haber pasado los 30 ciclos y que la maquina haya aprendido, le ponemos nuevos datos con los que nunca trabajo
test_inputs = [5, 6]
#Le ponemos nuevos objetivos que son el doble igual que los anteriores 
test_targets = [10, 12]
#Generamos una nueva prediccion para estos nuevos numeros, basado en el aprendizaje anterior del peso que ya deberia rondar en el 19999
pred = [predict(i) for i in test_inputs]
#Bucle que imprime los resultados finales de buena manera 
#Zip agrupa el input i, los targets t y la prediccion p
#Imprime los resultados y la prediccion con 4 decimales
for i, t, p in zip(test_inputs, test_targets, pred):
  print(f"input:{i}, target:{t}, pred:{p:.4f}")
